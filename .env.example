# NAMES ONLY. Real values go in ignored files (apps/web/.env.local, a local .env) or in Railway's encrypted variables.
# Never paste a value here, in docs, in issues, or in a shell command line. See docs/DEPLOYMENT.md.

# =========================== apps/web (Railway service "Enigma") ===========================
PORT=3000
ENIGMA_AUTH_PROVIDER=cognito                   # cognito | (unset = Clerk if its keys exist). Selecting Cognito disables Clerk
NEXT_PUBLIC_COGNITO_REGION=                    # public identifiers, safe in the browser bundle (read at runtime server-side)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=                 # PUBLIC app client: NO secret, ALLOW_USER_PASSWORD_AUTH + ALLOW_REFRESH_TOKEN_AUTH
ENIGMA_PUBLIC_ORIGIN=                          # exact public https origin (redirects)
ENIGMA_PUBLIC_HOST=                            # exact public host (CSRF same-origin allow-list)
ENIGMA_API_URL=                                # server-only: private http://<api>.railway.internal:<port> (alias ENIGMA_API_BASE_URL)

# =========================== apps/api (Railway service "enigma-api", Python 3.13) ===========================
# ENIGMA_ENV=production is baked into the image; Railway platform variables also force production posture.
ENIGMA_STORE=postgres                          # postgres | dynamodb | supabase | memory (memory is refused in production)
ENIGMA_DB_DSN=                                 # libpq DSN of the least-privilege role, sslmode=require. SECRET
ENIGMA_DB_ADMIN_DSN=                           # ONLY during the first bootstrap (python -m enigma_api.bootstrap); delete afterwards. SECRET
ENIGMA_DB_APP_PASSWORD=                        # password the bootstrap gives the application role (>= 24 chars). SECRET
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_TOKEN_USE=access                       # access | id

# --- Neon Managed Better Auth (additive to Cognito; off unless ENIGMA_NEON_AUTH=on). Values go in Railway variables / ignored local files only. ---
# web service:  ENIGMA_NEON_AUTH=on   NEON_AUTH_BASE_URL=<branch Auth URL, https>   NEON_AUTH_COOKIE_SECRET=<>=32 random chars, server secret, never NEXT_PUBLIC_>
# api service:  NEON_AUTH_BASE_URL=<same public Auth URL>  (tokens: EdDSA, iss=aud=its origin; JWKS <url>/.well-known/jwks.json)
# both:         ENIGMA_NEON_REQUIRE_VERIFIED_EMAIL=true (default; only an explicit "false" relaxes it, for a local test branch)
ENIGMA_NEON_AUTH=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
CRON_SECRET=                                   # >= 24 random chars; protects /api/v1/admin/prune and /admin/ready. SECRET
ENIGMA_AWS_OPS=off                             # dormant AWS operations page: off | mock (synthetic) | live
# ENIGMA_ADMIN_SUBJECTS=                       # comma-separated verified ids allowed to use the AWS operations page, e.g. cognito:<sub>

# =========================== optional alternative stores / providers (not used in production) ===========================
# ENIGMA_DDB_TABLE=                            # ENIGMA_STORE=dynamodb (needs AWS credentials from a role, never an SSO session)
# SUPABASE_URL=  SUPABASE_SERVICE_ROLE_KEY=    # ENIGMA_STORE=supabase (server only)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  CLERK_SECRET_KEY=  CLERK_JWKS_URL=  CLERK_ISSUER=  CLERK_AUTHORIZED_PARTIES=   # Clerk provider

# =========================== GPU host / Kaggle (Kaggle Secrets, not a file) ===========================
# ENIGMA_RUNTIME_TOKEN=                        # issued once in the Enigma UI; stored hashed server-side
# ENIGMA_API_URL=                              # the API's public https origin
# ENIGMA_CLAIM_POLL_S=  ENIGMA_CLAIM_POLL_IDLE_S=  ENIGMA_CLAIM_HOT_WINDOW_S=   # optional API-cost tuning

# =========================== LOCAL DEV / E2E ONLY (refused in production and on Railway) ===========================
# ENIGMA_DEV_AUTH=1            (web)   |   ENIGMA_DEV_AUTH=true (api)
# ENIGMA_DEV_JWT_SECRET=       (>= 32 random chars, identical for web and api; generate it, never commit it)

# =========================== tooling (never committed) ===========================
# AWS_PROFILE=  AWS_REGION=    # AWS CLI via IAM Identity Center only; no access keys
# ENIGMA_LIVE_DDB*             # opt-in real-DynamoDB parity run, see docs/AWS_DYNAMODB_REAL_PARITY.md
