# NAMES ONLY. Real values go in ignored files (apps/web/.env.local, a local .env) or in Railway's encrypted variables.
# Never paste a value here, in docs, in issues, or in a shell command line.
# Architecture: Railway (web + api) + Neon PostgreSQL + Neon Managed Better Auth. Inference runs on Kaggle, outside Railway.

# =========================== apps/web (Railway service "enigma-web") ===========================
PORT=3000
ENIGMA_ENV=production
ENIGMA_AUTH_PROVIDER=neon
ENIGMA_NEON_AUTH=on                            # on = Neon Managed Better Auth is the sign-in provider (anything else disables it)
NEON_AUTH_BASE_URL=                            # the branch's public Auth URL (https). Not a secret
NEON_AUTH_COOKIE_SECRET=                       # >= 32 random chars. SECRET, server only, never NEXT_PUBLIC_
ENIGMA_NEON_REQUIRE_VERIFIED_EMAIL=true        # default; only an explicit "false" relaxes it (local test branch)
ENIGMA_PUBLIC_ORIGIN=                          # exact public https origin (redirects, verification callback)
ENIGMA_PUBLIC_HOST=                            # exact public host (CSRF same-origin allow-list)
ENIGMA_API_URL=                                # server-only: private http://<api>.railway.internal:<port> (alias ENIGMA_API_BASE_URL)

# =========================== apps/api (Railway service "enigma-api", Python 3.13) ===========================
# ENIGMA_ENV=production is baked into the image; Railway platform variables also force production posture.
ENIGMA_STORE=postgres                          # postgres | memory (memory is refused in production)
ENIGMA_DB_DSN=                                 # libpq DSN of the least-privilege role, sslmode=verify-full (Neon). SECRET
ENIGMA_AUTH_PROVIDER=neon
NEON_AUTH_BASE_URL=                            # same public Auth URL as the web service (tokens: EdDSA, iss=aud=its origin)
ENIGMA_NEON_REQUIRE_VERIFIED_EMAIL=true
CRON_SECRET=                                   # >= 24 random chars; protects /api/v1/admin/prune and /admin/ready. SECRET
# ENIGMA_ADMIN_SUBJECTS=                       # comma-separated verified ids shown as admin by /app/me, e.g. neon:<uuid>

# --- one-off database bootstrap (python -m enigma_api.bootstrap). Set only while bootstrapping, then delete. ---
# ENIGMA_DB_ADMIN_DSN=                         # direct (non-pooled) DSN of an owner role. SECRET
# ENIGMA_DB_APP_PASSWORD=                      # password given to the application role (>= 24 chars). SECRET

# =========================== GPU host / Kaggle (Kaggle Secrets, not a file) ===========================
# ENIGMA_RUNTIME_TOKEN=                        # issued once in the Enigma UI; stored hashed server-side
# ENIGMA_API_URL=                              # the API's public https origin
# ENIGMA_CLAIM_POLL_S=  ENIGMA_CLAIM_POLL_IDLE_S=  ENIGMA_CLAIM_HOT_WINDOW_S=   # optional API-cost tuning

# =========================== LOCAL DEV / E2E ONLY (refused in production and on Railway) ===========================
# ENIGMA_DEV_AUTH=1            (web)   |   ENIGMA_DEV_AUTH=true (api)
# ENIGMA_DEV_JWT_SECRET=       (>= 32 random chars, identical for web and api; generate it, never commit it)
