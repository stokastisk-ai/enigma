# NAMES ONLY. Real values go in ignored files (apps/web/.env.local, a local .env) or in the provider's encrypted settings.
# Never paste a value here, in docs, in issues, or in a shell command line.

# =========================== apps/web (Vercel project for the web app) ===========================
# --- public: allowed in the browser bundle (identifiers / publishable keys only) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=          # legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also read
# --- server-only ---
CLERK_SECRET_KEY=
ENIGMA_API_URL=                                # base URL of the FastAPI deployment, e.g. https://<api-host>

# =========================== apps/api (FastAPI, Python 3.13) ===========================
ENIGMA_ENV=production                          # development | test | production
ENIGMA_STORE=supabase                          # memory is refused in production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                     # SERVER ONLY. Bypasses RLS; never in a browser bundle, notebook, or Git
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=                      # comma-separated web origins allowed as the token's azp
CRON_SECRET=                                   # >= 24 random chars; Vercel Cron sends it as a Bearer token

# =========================== migration tooling only (local, NEVER deployed) ===========================
# Only if you apply migrations with the Supabase CLI instead of the dashboard SQL editor.
# Must point at the dedicated Enigma Supabase project, never localhost and never another project's database.
# DIRECT_URL=

# =========================== GPU host / Kaggle (Kaggle Secrets, not a file) ===========================
# ENIGMA_RUNTIME_TOKEN=                        # issued once in the Enigma UI; stored hashed server-side
# ENIGMA_API_URL=

# =========================== LOCAL DEV / E2E ONLY (refused on Vercel and in production) ===========================
# ENIGMA_DEV_AUTH=1            (web)   |   ENIGMA_DEV_AUTH=true (api)
# ENIGMA_DEV_JWT_SECRET=       (>= 32 random chars, identical for web and api; generate it, never commit it)
