# /opt/enigma/secrets/web.env (0600). Names only.
ENIGMA_PUBLIC_ORIGIN=
ENIGMA_PUBLIC_HOST=
ENIGMA_PUBLIC_API_URL=
BETTER_AUTH_SECRET=
# postgresql://enigma_web_auth:<password>@db:5432/enigma?sslmode=verify-full&sslrootcert=/run/pg-ca/ca.crt
ENIGMA_AUTH_DB_DSN=
# Leave empty until a trusted sender on an owner-controlled domain is verified (sign-up stays closed meanwhile):
ENIGMA_SMTP_URL=
ENIGMA_MAIL_FROM=
