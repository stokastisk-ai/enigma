      "x": 0,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/DynamoDB",
            "SystemErrors",
            "TableName",
            "${DDB_TABLE_NAME}",
            "Operation",
            "GetItem",
            {
              "stat": "Sum",
              "label": "GetItem"
