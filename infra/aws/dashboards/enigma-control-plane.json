        "stacked": false,
        "region": "${AWS_REGION}",
        "title": "DynamoDB: consumed capacity (capacity units)",
        "period": 300,
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 15,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/DynamoDB",
            "ReadThrottleEvents",
            "TableName",
            "${DDB_TABLE_NAME}",
