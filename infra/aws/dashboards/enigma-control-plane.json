            "AWS/DynamoDB",
            "SystemErrors",
            "TableName",
            "${DDB_TABLE_NAME}",
            "Operation",
            "UpdateItem",
            {
              "stat": "Sum",
              "label": "UpdateItem"
            }
          ],
          [
            "AWS/DynamoDB",
            "SystemErrors",
            "TableName",
            "${DDB_TABLE_NAME}",
            "Operation",
            "PutItem",
            {
              "stat": "Sum",
              "label": "PutItem"
            }
          ],
          [
            "AWS/DynamoDB",
            "SystemErrors",
            "TableName",
            "${DDB_TABLE_NAME}",
            "Operation",
            "TransactWriteItems",
            {
              "stat": "Sum",
              "label": "TransactWriteItems"
            }
