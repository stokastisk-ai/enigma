        "stacked": false,
        "region": "${AWS_REGION}",
        "title": "DynamoDB: system errors by operation (count)",
        "period": 300,
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/DynamoDB",
            "SuccessfulRequestLatency",
            "TableName",
            "${DDB_TABLE_NAME}",
            "Operation",
            "Query",
            {
              "stat": "Average",
              "label": "Query latency avg (ms)"
            }
          ],
          [
            "AWS/DynamoDB",
            "SuccessfulRequestLatency",
            "TableName",
            "${DDB_TABLE_NAME}",
            "Operation",
            "TransactWriteItems",
            {
              "stat": "Average",
              "label": "TransactWriteItems latency avg (ms)"
            }
          ],
          [
            "AWS/DynamoDB",
            "TimeToLiveDeletedItemCount",
            "TableName",
            "${DDB_TABLE_NAME}",
            {
              "stat": "Sum",
              "label": "TTL deleted items (count)"
            }
          ]
