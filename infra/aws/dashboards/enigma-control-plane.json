{
  "start": "-PT3H",
  "periodOverride": "auto",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 3,
      "properties": {
        "markdown": "# Enigma control plane (AWS operations only)\n**DRAFT. NOT DEPLOYED.** Placeholders `${...}` must be substituted from an approved resource manifest. This dashboard shows only AWS-provided metrics for the Enigma web and API Lambdas, DynamoDB and CloudFront. It does **not** show GPU or vLLM data: those come from the Kaggle 2x T4 session inside Enigma (nvidia-ml-py / vLLM /metrics). No AWS GPU exists."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "${WEB_FUNCTION_NAME}",
            {
              "stat": "Sum",
              "label": "Invocations"
            }
          ],
          [
            "AWS/Lambda",
            "Errors",
            "FunctionName",
            "${WEB_FUNCTION_NAME}",
            {
              "stat": "Sum",
              "label": "Errors"
            }
          ],
          [
            "AWS/Lambda",
            "Throttles",
            "FunctionName",
            "${WEB_FUNCTION_NAME}",
            {
              "stat": "Sum",
              "label": "Throttles"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "title": "Web Lambda: invocations, errors, throttles (count)",
        "period": 300,
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/Lambda",
            "Duration",
            "FunctionName",
            "${WEB_FUNCTION_NAME}",
            {
              "stat": "Average",
              "label": "Duration avg (ms)"
            }
          ],
          [
            "AWS/Lambda",
            "Duration",
            "FunctionName",
            "${WEB_FUNCTION_NAME}",
            {
              "stat": "p95",
              "label": "Duration p95 (ms)"
            }
          ],
          [
            "AWS/Lambda",
            "ConcurrentExecutions",
            "FunctionName",
            "${WEB_FUNCTION_NAME}",
            {
              "stat": "Maximum",
              "label": "Max concurrent (count)"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "title": "Web Lambda: duration and concurrency (ms / count)",
        "period": 300,
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "${API_FUNCTION_NAME}",
            {
              "stat": "Sum",
              "label": "Invocations"
            }
          ],
          [
            "AWS/Lambda",
            "Errors",
            "FunctionName",
            "${API_FUNCTION_NAME}",
            {
              "stat": "Sum",
              "label": "Errors"
            }
          ],
          [
            "AWS/Lambda",
            "Throttles",
            "FunctionName",
            "${API_FUNCTION_NAME}",
            {
              "stat": "Sum",
              "label": "Throttles"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "title": "API Lambda: invocations, errors, throttles (count)",
        "period": 300,
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/Lambda",
            "Duration",
            "FunctionName",
            "${API_FUNCTION_NAME}",
            {
              "stat": "Average",
              "label": "Duration avg (ms)"
            }
          ],
          [
            "AWS/Lambda",
            "Duration",
            "FunctionName",
            "${API_FUNCTION_NAME}",
            {
              "stat": "p95",
              "label": "Duration p95 (ms)"
            }
          ],
          [
            "AWS/Lambda",
            "ConcurrentExecutions",
            "FunctionName",
            "${API_FUNCTION_NAME}",
            {
              "stat": "Maximum",
              "label": "Max concurrent (count)"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "title": "API Lambda: duration and concurrency (ms / count)",
        "period": 300,
        "yAxis": {
          "left": {
            "min": 0
